DB_URL=jdbc:postgresql://localhost:5432/dzimbahub
DB_USER=postgres
DB_PASSWORD=change-me
APP_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
APP_JWT_EXPIRATION_MS=86400000
PORT=8080

FRONTEND_ORIGIN=https://your-dzimbahub-frontend.vercel.app
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=use-a-unique-password-at-least-12-characters

# Paynow merchant credentials (obtain from your Paynow merchant account)
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# Public HTTPS URL of this backend, used for Paynow result notifications
PUBLIC_API_URL=https://your-dzimbahub-api.onrender.com
# Public frontend URL for post-payment return navigation
APP_FRONTEND_URL=https://your-dzimbahub-frontend.vercel.app
